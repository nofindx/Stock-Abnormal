# 后端读取的 Tushare Token；不要写入小程序前端。
TUSHARE_TOKEN=

# CloudBase MySQL：只保存单股计算的最小基础数据，不保存原始日线。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=stock_abnormal

# 后端监听地址
HOST=0.0.0.0
PORT=8787

# 生产和开发联调均禁止返回演示降级数据
ALLOW_DEMO_FALLBACK=false

# 生产盘中状态必须使用共享 Redis；本地未配置时仅使用进程内测试回退
REDIS_URL=

# 重点监控公告代理的公网地址；本地联调可留空
MONITOR_PUBLIC_BASE_URL=
