  "findings": [
    {
      "id": "PERF-001",
      "status": "observed_and_code_confirmed",
      "finding": "Three serial frontend requests (context, authorized S1 GET, S2 POST) on first open and explicit manual refresh. Context builds and persists the complete S1 before a separate GET returns it. Four concurrent flows spent 1874.9-2217.3 ms in context. Each capture reads the full active monitor snapshot before security filtering and opens multiple MySQL connections.",
      "recommendation": "Profile and reduce capture read/serialization cost; cache immutable snapshot content by actual publication identity while rechecking the latest pointer on each manual S1; combine/reuse database reads. Consider an optional atomic context-with-S1 response to save one network round trip, retaining scoped token, immutable S1, latest manual S1, existing endpoints and old-client compatibility."
    },
    {
      "id": "PERF-002",
      "status": "locally_reproduced",
      "finding": "TushareClient._cached keeps one shared mutex while loader performs network I/O, so an unrelated slow source request blocks cached calendar and suspension reads.",
      "recommendation": "Keep cache metadata lock short; merge concurrent misses per cache key outside the shared metadata lock. Preserve status evidence and existing validity periods."
    },
    {
      "id": "PERF-003",
      "status": "code_path_confirmed_not_live_failure_observed",
      "finding": "Sources run sequentially with four-second socket timeouts; Eastmoney loops over securities sequentially. There is no whole-refresh wall-clock budget, so slow fallback can occupy two S2 workers and cause polling and waits.",
      "recommendation": "Bound the complete quote attempt, use bounded fallback concurrency, retain source/date/time pairing and failure disclosure; do not extend three-second quote freshness to hide waits."
    },
    {
      "id": "PERF-004",
      "status": "cache_behavior_verified",
      "finding": "Same-stock same-boundary memory reuse produced zero requests and completed in 37 ms. The devtools stock render synchronous samples were 5-12 ms. Prediction first/manual cloud page samples completed in 1104/994 ms; stock first/manual in 1214/627 ms.",
      "recommendation": "Retain first-open/manual refresh and boundary invalidation semantics. Add safe per-stage latency evidence before considering resource scaling."
    }
  ],
  "limitations": [
    "Night/pre-open point-in-time samples, not trading-session benchmark.",
    "Official DevTools callContainer is not a physical phone network or rendering test.",
    "Four concurrent flows are one low-load sample, not p95/p99 or capacity certification.",
    "The automator route helper includes a fixed 3000 ms delay; reported cloud page timings are measured within the page and exclude that helper delay. Earlier exploratory helper totals are not used.",
    "No cloud CPU, memory or instance identity metrics were inspected, so resource saturation and instance count are not established.",
    "Source health sample observed Tencent successes and last latency 129.6 ms, Tushare suspend_d 67.8 ms. Fallback slowness is a code-confirmed risk rather than a reproduced live provider outage.",
    "The user phone version and observed duration were requested and may differ from the inspected 2.0.4 build."
  ],
