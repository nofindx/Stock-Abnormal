.legal-page { min-height: 100vh; padding: 34rpx 28rpx 120rpx; background: #F2F3F5; color: #1A1A1A; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.legal-updated { margin-top: 8rpx; color: #9CA3AF; font-size: 20rpx; line-height: 30rpx; }
.legal-section { margin-top: 20rpx; padding: 22rpx 20rpx; border: 1rpx solid #EBEDF0; border-radius: 16rpx; background: #FFFFFF; }
.legal-heading { color: #1A1A1A; font-size: 26rpx; font-weight: 700; line-height: 36rpx; }
.legal-copy { margin-top: 12rpx; color: #6B7280; font-size: 23rpx; line-height: 38rpx; }
