.stock-page { padding-top: 24rpx; padding-bottom: 220rpx; }
.search-wrap { position: relative; z-index: 2; display: flex; height: 82rpx; flex-direction: column; align-items: center; justify-content: flex-start; margin-top: 12rpx; padding-top: 10rpx; }
.search-box {
  display: flex;
  width: 100%;
  height: 72rpx;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid #E5E5EA;
  border-radius: 11rpx;
  background: #FFFFFF;
}
.search-box.focused { border-color: #007AFF; box-shadow: 0 0 0 4rpx rgba(0, 122, 255, .12); }
.search-icon {
  position: relative;
  width: 27rpx;
  height: 27rpx;
  flex: 0 0 27rpx;
  margin-right: 14rpx;
  border: 2rpx solid #8E8E93;
  border-radius: 50%;
}
.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 9rpx;
  height: 2rpx;
  border-radius: 3rpx;
  background: #8E8E93;
  content: '';
  transform: rotate(45deg);
}
.search-input { min-width: 0; height: 70rpx; flex: 1; color: #1C1C1E; font-size: 25rpx; }
.clear-icon { padding: 8rpx 2rpx 8rpx 14rpx; color: #8E8E93; font-size: 32rpx; }
.suggestions {
  position: absolute;
  z-index: 10;
  top: 84rpx;
  right: 0;
  left: 0;
  overflow: hidden;
  padding: 0 16rpx;
  border-radius: 11rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 28, 30, .12);
}
.suggestion { display: flex; min-height: 82rpx; align-items: center; justify-content: space-between; gap: 14rpx; border-bottom: 1rpx solid #F2F2F7; }
.suggestion:last-child { border-bottom: 0; }
.suggestion-identity { display: flex; min-width: 0; flex: 1; align-items: baseline; gap: 10rpx; }
.suggestion-name { color: #1C1C1E; font-size: 27rpx; font-weight: 550; }
.suggestion-code { flex: 0 0 auto; color: #8E8E93; font-size: 22rpx; font-variant-numeric: tabular-nums; }
.suggestion-market { flex: 0 0 86rpx; color: #1C1C1E; font-size: 24rpx; text-align: right; }
.stock-meta { color: #8E8E93; font-size: 21rpx; font-variant-numeric: tabular-nums; }
.st-badge { padding: 2rpx 7rpx; border-radius: 6rpx; background: #FCEBEA; color: #C83A36; font-size: 18rpx; font-weight: 600; line-height: 24rpx; }
.suggestion-hint { padding: 14rpx 0 16rpx; color: #8E8E93; font-size: 20rpx; line-height: 28rpx; text-align: left; }
.inline-error { margin-top: 10rpx; color: #C83A36; font-size: 20rpx; line-height: 28rpx; }
.stock-update-row { display: flex; height: 48rpx; min-height: 48rpx; align-items: center; margin-top: 12rpx; color: #6B7280; font-size: 22rpx; line-height: 30rpx; white-space: nowrap; }
.stock-update-row { justify-content: flex-end; text-align: right; }
.stock-update-text { overflow: hidden; text-overflow: ellipsis; }
.loading-state, .error-state { margin-top: 20rpx; padding: 34rpx 24rpx; color: #8E8E93; text-align: center; }
.error-state { color: #C83A36; }
.history-row { display: flex; width: 100%; height: 64rpx; min-height: 64rpx; align-items: center; gap: 10rpx; margin-top: 12rpx; padding: 0 12rpx; box-sizing: border-box; border-radius: 11rpx; background: #FFFFFF; }
.history-title-wrap, .history-clear { display: flex; align-items: center; }
.history-title-wrap { gap: 9rpx; }
.history-label { color: #8E8E93; font-size: 20rpx; }
.history-clock { position: relative; width: 24rpx; height: 24rpx; flex: 0 0 24rpx; box-sizing: border-box; border: 2rpx solid #9CA3AF; border-radius: 50%; }
.clock-hand { position: absolute; left: 9rpx; bottom: 9rpx; width: 2rpx; border-radius: 2rpx; background: #9CA3AF; transform-origin: bottom center; }
.clock-hand-hour { height: 6rpx; }
.clock-hand-minute { height: 8rpx; transform: rotate(125deg); }
.history-clear { display: flex; width: 82rpx; height: 48rpx; flex: 0 0 82rpx; align-items: center; justify-content: center; gap: 6rpx; margin-left: 2rpx; border: 1rpx solid #E1E4E8; border-radius: 8rpx; background: #F7F8FA; color: #62666D; font-size: 18rpx; }
.history-clear-pressed { background: #E9ECF0; }
.history-scroll { min-width: 0; height: 52rpx; flex: 1; white-space: nowrap; }
.history-items { display: flex; width: 100%; height: 52rpx; align-items: center; gap: 8rpx; white-space: nowrap; }
.history-empty { color: #A0A4AA; font-size: 19rpx; }
.history-chip { display: inline-flex; max-width: 200rpx; height: 42rpx; flex: 0 0 auto; align-items: center; overflow: hidden; padding: 0 13rpx; border-radius: 7rpx; background: #F3F4F6; color: #55585D; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.history-trash { position: relative; display: flex; width: 20rpx; height: 24rpx; align-items: center; justify-content: center; }
.trash-lid { position: absolute; top: 2rpx; width: 15rpx; height: 2rpx; border-radius: 2rpx; background: #737982; }
.trash-lid::before { position: absolute; top: -4rpx; left: 5rpx; width: 5rpx; height: 2rpx; border-radius: 2rpx 2rpx 0 0; background: #737982; content: ''; }
.trash-can { display: flex; width: 12rpx; height: 15rpx; justify-content: space-evenly; margin-top: 7rpx; padding-top: 3rpx; box-sizing: border-box; border: 1.5rpx solid #737982; border-top: 0; border-radius: 0 0 3rpx 3rpx; }
.trash-can view { width: 1.5rpx; height: 8rpx; border-radius: 1rpx; background: #737982; }
.recent-head { margin-top: 30rpx; }
.clear-link, .text-button { padding: 0; border: 0; background: transparent; color: #007AFF; font-size: 22rpx; }
.recent-list { overflow: hidden; }
.recent-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #F2F2F7;
}
.recent-row:last-child { border-bottom: 0; }
.stock-name { color: #1C1C1E; font-size: 27rpx; font-weight: 600; }
.stock-name .badge { margin-left: 8rpx; vertical-align: 3rpx; }
.stock-meta { display: block; margin-top: 4rpx; }
.change { font-size: 27rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.up { color: #D94A45; }
.down { color: #16835D; }
.neutral { color: #6B7280; }
.guide-card { margin-top: 84rpx; padding: 32rpx 28rpx 34rpx; }
.guide-target { width: 176rpx; height: 176rpx; margin: 2rpx auto 30rpx; position: relative; }
.guide-ring { display: flex; align-items: center; justify-content: center; border: 10rpx solid #202936; border-radius: 50%; }
.guide-ring-outer { width: 176rpx; height: 176rpx; }
.guide-ring-middle { width: 120rpx; height: 120rpx; border-width: 9rpx; }
.guide-ring-inner { width: 64rpx; height: 64rpx; border-width: 8rpx; position: relative; }
.guide-pointer { position: absolute; width: 96rpx; height: 12rpx; left: 37rpx; top: 25rpx; border-radius: 12rpx; background: #C65B3B; transform: rotate(-22deg); transform-origin: left center; }
.guide-line { display: block; line-height: 38rpx; }
.guide-line-primary { color: #1C1C1E; font-size: 29rpx; font-weight: 650; text-align: center; }
.guide-lines { display: flex; width: 100%; flex-direction: column; align-items: center; margin-top: 16rpx; }
.guide-line-secondary { width: 100%; color: #1C1C1E; font-size: 23rpx; text-align: center; }
.guide-line-item { width: 100%; color: #1C1C1E; font-size: 24rpx; text-align: center; text-indent: 0; }
.guide-bullet { display: inline-block; width: 28rpx; color: #1C1C1E; font-weight: 700; text-align: center; }

.status-banner {
  display: block;
  margin-top: 8rpx;
  padding: 20rpx 18rpx 16rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
}
.status-safe { border-color: #B8DEC7; background: #EAF5EF; color: #1C1C1E; }
.status-risk, .status-severe { border-color: #F0C1BA; background: #FDF3F2; color: #1C1C1E; }
.status-monitoring { border-color: #F0C1BA; background: #FDF3F2; color: #1C1C1E; }
.status-neutral { border-color: #E5E5EA; background: #FAFBFC; color: #1C1C1E; }
.status-icon { display: none; }
.status-main { min-width: 0; width: 100%; }
.summary-top { display: flex; min-height: 54rpx; align-items: center; justify-content: space-between; gap: 12rpx; }
.status-pill { display: inline-flex; flex: 0 0 auto; align-items: center; padding: 4rpx 12rpx; border-radius: 7rpx; background: #F2F3F5; color: #4B5563; font-size: 19rpx; font-weight: 600; line-height: 28rpx; }
.status-stock-line .status-pill { position: relative; top: 20rpx; }
.status-pill-safe { border: 1rpx solid #A8D5B5; background: #F1FAF3; color: #2E7D32; }
.status-pill-risk { border: 1rpx solid #E7A8A2; background: #FDF3F2; color: #C0271E; }
.status-pill-monitoring { background: #F2F3F5; color: #1C1C1E; }
.status-heading { display: flex; min-height: 34rpx; align-items: center; gap: 10rpx; }
.status-state { color: #636366; font-size: 29rpx; font-weight: 700; line-height: 38rpx; }
.status-safe .status-state { color: #248A5A; }
.status-risk .status-state, .status-severe .status-state { color: #C0271E; }
.status-monitoring .status-state, .monitoring-reason { color: #C0271E; }
.monitoring-reason { margin-top: 6rpx; font-size: 20rpx; line-height: 28rpx; }
.monitoring-status { margin-top: 4rpx; color: #4B5563; font-size: 20rpx; line-height: 28rpx; }
.market-status-reason { margin-top: 4rpx; color: #4B5563; font-size: 20rpx; line-height: 28rpx; }
.status-board { margin-left: auto; padding: 0; color: #6B7280; font-size: 19rpx; line-height: 28rpx; }
.summary-top .stock-identity { display: flex; min-width: 0; align-items: baseline; gap: 12rpx; overflow: hidden; }
.summary-top .quote-line { flex: 0 0 auto; justify-content: flex-end; margin-left: auto; }
.status-name { min-width: 0; overflow: hidden; color: #1A1A1A; font-size: 30rpx; font-weight: 600; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.summary-top .status-symbol { flex: 0 0 auto; margin: 0; color: #6B7280; font-size: 20rpx; line-height: 28rpx; font-variant-numeric: tabular-nums; white-space: nowrap; }
.status-label-divider { margin-top: 12rpx; border-top: 1rpx solid #F2F2F7; }
.status-stock-line { display: block; min-width: 0; margin-top: 0; }
.next-day-forecast { display: flex; flex-direction: column; gap: 4rpx; margin-top: 28rpx; color: #4B5563; font-size: 20rpx; font-weight: 400; line-height: 28rpx; }
.next-day-forecast-date,
.next-day-forecast-result { display: block; color: #4B5563; font-size: 20rpx; font-weight: 400; line-height: 28rpx; overflow-wrap: anywhere; }
.monitoring-summary { margin-top: 16rpx; }
.monitoring-divider { border-top: 1rpx solid #E5E7EB; }
.monitoring-badge { display: inline-flex; margin-top: 12rpx; padding: 4rpx 12rpx; border: 1rpx solid #E7A8A2; border-radius: 7rpx; background: #FDF3F2; color: #C0271E; font-size: 19rpx; font-weight: 600; line-height: 28rpx; }
.monitoring-meta,
.monitoring-reason { display: block; color: #4B5563; font-size: 20rpx; font-weight: 400; line-height: 28rpx; overflow-wrap: anywhere; }
.monitoring-meta { margin-top: 8rpx; }
.monitoring-reason { margin-top: 4rpx; }
.monitoring-emphasis { color: #C0271E; font-weight: 600; }
.stock-identity { display: flex; min-width: 0; align-items: baseline; gap: 14rpx; }
.quote-line { display: flex; min-width: 0; flex: 1; align-items: baseline; gap: 12rpx; }
.quote-line .status-price.change { color: #D93025; font-size: 48rpx; font-weight: 700; line-height: 54rpx; font-variant-numeric: tabular-nums; }
.status-price.change.down { color: #16835D; }
.quote-line .change { color: #D93025; font-size: 32rpx; font-weight: 700; }

.metric-grid { display: grid; width: 100%; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 12rpx; margin-top: 12rpx; }
.metric-card { display: flex; width: 100%; min-width: 0; height: 184rpx; min-height: 184rpx; box-sizing: border-box; align-items: center; justify-content: space-between; gap: 8rpx; padding: 16rpx; border-radius: 12rpx; text-align: left; }
.metric-copy { display: flex; min-width: 0; flex: 1; align-self: stretch; flex-direction: column; justify-content: space-between; padding: 2rpx 0; }
.metric-label { display: inline-flex; max-width: 100%; align-items: center; align-self: flex-start; padding: 4rpx 12rpx; border: 1rpx solid #B9D6F2; border-radius: 7rpx; background: #EAF3FC; color: #185A96; font-size: 19rpx; font-weight: 600; line-height: 28rpx; white-space: nowrap; }
.metric-label-warning { border-color: #F0D36A; background: #FFF5CC; color: #8A6D0B; }
.metric-label-severe { border-color: #E7A8A2; background: #FDF3F2; color: #C0271E; }
.metric-label-unknown { border-color: #DCEBFA; background: #F3F8FD; color: #6B7280; }
.metric-ring { display: flex; width: 116rpx; height: 116rpx; flex: 0 0 116rpx; align-items: center; justify-content: center; border-radius: 50%; background: #E5E7EB; }
.metric-ring-inner { display: flex; width: 88rpx; height: 88rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: #FFFFFF; }
.metric-ring-value { max-width: 72rpx; overflow: hidden; color: #4B5563; font-size: 17rpx; font-weight: 650; line-height: 22rpx; font-variant-numeric: tabular-nums; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.metric-current { display: block; min-height: 36rpx; margin-top: auto; color: #1C1C1E; font-size: 24rpx; line-height: 32rpx; font-weight: 650; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.metric-current-compact { font-size: 21rpx; letter-spacing: 0; }
.metric-target { display: block; min-height: 28rpx; margin-top: 2rpx; color: #4B5563; font-size: 20rpx; line-height: 28rpx; overflow-wrap: anywhere; }

.alert-panel {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
}
.panel-title { color: #1C1C1E; font-size: 26rpx; font-weight: 600; }
.panel-icon { display: none; }
.alert-row { display: flex; flex-direction: column; gap: 9rpx; margin-top: 22rpx; color: #636366; font-size: 20rpx; }
.alert-row-head, .alert-values { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.alert-label { color: #636366; white-space: nowrap; }
.alert-track { height: 16rpx; overflow: hidden; border-radius: 10rpx; background: #ECEEF1; }
.alert-bar { height: 100%; min-width: 3rpx; border-radius: inherit; background: #8E8E93; }
.alert-bar.risk, .alert-bar.severe { background: #D94A45; }
.alert-bar.safe { background: #16835D; }
.alert-forecast { color: #636366; font-weight: 600; text-align: right; }
.alert-forecast.risk, .alert-forecast.severe { color: #C83A36; }
.alert-forecast.safe { color: #16835D; }
.alert-current { color: #1C1C1E; font-size: 24rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.alert-caption { color: #8E8E93; font-size: 18rpx; }

.simulation-section {
  overflow: hidden;
  padding: 18rpx 16rpx 16rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
}
.simulation-head { display: flex; min-height: 48rpx; align-items: center; justify-content: space-between; gap: 12rpx; padding: 0 2rpx; }
.simulation-heading { display: flex; min-width: 0; flex: 1; align-items: baseline; gap: 12rpx; }
.simulation-title { color: #1C1C1E; font-size: 26rpx; font-weight: 600; }
.simulation-icon { display: none; }
.days-picker { display: flex; flex: 0 0 auto; align-items: center; gap: 8rpx; color: #636366; font-size: 21rpx; }
.day-options { display: flex; gap: 5rpx; }
.day-option { min-width: 110rpx; padding: 8rpx 13rpx; border: 1rpx solid #8CB4DC; border-radius: 9rpx; background: #EAF3FC; color: #185A96; font-size: 20rpx; font-weight: 700; line-height: 30rpx; text-align: center; box-shadow: 0 2rpx 5rpx rgba(24, 90, 150, .10); transition: background-color .12s, transform .12s; }
.day-option.active { border-color: #7EA6CF; background: #E4EFFA; color: #194F83; }
.button-press { background: #D6E5F4 !important; transform: scale(.97); }
.simulation-note { min-width: 0; overflow: hidden; color: #8E8E93; font-size: 20rpx; line-height: 30rpx; text-align: left; text-overflow: ellipsis; white-space: nowrap; }
.matrix-card { overflow: hidden; margin-top: 14rpx; border: 1rpx solid #E5E5EA; border-radius: 14rpx; background: #FFFFFF; }
.matrix-head, .matrix-row { display: grid; align-items: center; }
.matrix-count-2 .matrix-head, .matrix-count-2 .matrix-row { grid-template-columns: 126rpx repeat(2, minmax(0, 1fr)); }
.matrix-count-5 .matrix-head, .matrix-count-5 .matrix-row { grid-template-columns: 118rpx repeat(5, minmax(0, 1fr)); }
.matrix-head { min-height: 70rpx; background: #F8F8FA; text-align: center; }
.matrix-row { min-height: 70rpx; border-top: 1rpx solid #F2F2F7; }
.matrix-label { padding: 0 5rpx; color: #636366; font-size: 21rpx; line-height: 28rpx; text-align: center; }
.matrix-head .matrix-label { color: #636366; font-weight: 600; }
.matrix-column { display: flex; flex-direction: column; align-items: center; gap: 1rpx; }
.matrix-column .day-badge { padding: 0; border: 0; background: transparent; color: #1C1C1E; font-size: 21rpx; font-weight: 600; line-height: 28rpx; }
.table-date { color: #8E8E93; font-size: 18rpx; line-height: 23rpx; }
.matrix-cell { display: flex; min-width: 0; align-items: center; justify-content: center; }
.matrix-input-wrap { display: inline-flex; width: 92%; height: 44rpx; align-items: center; justify-content: center; border: 1rpx solid #D1D1D6; border-radius: 8rpx; background: #FFFFFF; }
.matrix-suffix { flex: 0 0 auto; color: #8E8E93; font-size: 17rpx; line-height: 42rpx; }
.matrix-input { width: 38rpx; height: 42rpx; min-width: 0; flex: 0 0 38rpx; padding: 0; border: 0; background: transparent; color: #1C1C1E; font-size: 20rpx; font-variant-numeric: tabular-nums; text-align: right; }
.matrix-placeholder { color: #C7C7CC; font-size: 20rpx; }
.matrix-value { color: #1C1C1E; font-size: 21rpx; font-variant-numeric: tabular-nums; white-space: nowrap; }
.matrix-value.risk { color: #D94A45; }
.matrix-value.safe { color: #16835D; }
.matrix-value.safety-value { color: #1C1C1E; font-weight: 600; }
.stock-page .free-note { margin-top: 24rpx; }
.stock-page .free-note { text-align: right; }

/* Single-stock warnings and controls are grayscale; quote change stays red/green. */
.stock-page .search-box.focused { border-color: #6B7280 !important; box-shadow: 0 0 0 4rpx rgba(75, 85, 99, .12) !important; }
.stock-page .st-badge,
.stock-page .error-state { background: #F2F3F5 !important; color: #4B5563 !important; }
.stock-page .inline-error,
.stock-page .clear-link,
.stock-page .text-button { color: #4B5563 !important; }
.stock-page .quote-line .change.up { color: #D93025 !important; }
.stock-page .quote-line .change.down { color: #16835D !important; }
.stock-page .guide-ring { border-color: #F5C542 !important; }
.stock-page .guide-pointer { background: #D93025 !important; }
.stock-page .status-safe,
.stock-page .status-risk,
.stock-page .status-severe,
.stock-page .status-monitoring,
.stock-page .status-neutral { border-color: #D1D5DB !important; background: #FFFFFF !important; color: #1C1C1E !important; }
.stock-page .status-safe .status-state,
.stock-page .status-risk .status-state,
.stock-page .status-severe .status-state,
.stock-page .status-monitoring .status-state,
.stock-page .monitoring-meta,
.stock-page .monitoring-reason { color: #4B5563 !important; }
.stock-page .monitoring-meta .monitoring-emphasis { color: #C0271E !important; }
.stock-page .alert-bar,
.stock-page .alert-bar.risk,
.stock-page .alert-bar.severe,
.stock-page .alert-bar.safe,
.stock-page .alert-forecast,
.stock-page .alert-forecast.risk,
.stock-page .alert-forecast.severe,
.stock-page .alert-forecast.safe,
.stock-page .matrix-value.risk,
.stock-page .matrix-value.safe { color: #4B5563 !important; background: #6B7280 !important; }
.stock-page .alert-forecast,
.stock-page .alert-forecast.risk,
.stock-page .alert-forecast.severe,
.stock-page .alert-forecast.safe { background: transparent !important; }
.stock-page .matrix-value.risk,
.stock-page .matrix-value.safe { color: #1C1C1E !important; background: transparent !important; }
.stock-page .day-option,
.stock-page .day-option.active { border-color: #9CA3AF !important; background: #F2F3F5 !important; color: #1C1C1E !important; box-shadow: none !important; }
.stock-page .button-press { background: #E5E7EB !important; }

@media (max-width: 390px) {
  .metric-card { height: 176rpx; min-height: 176rpx; padding: 13rpx; }
  .metric-ring { width: 92rpx; height: 92rpx; flex-basis: 92rpx; }
  .metric-ring-inner { width: 70rpx; height: 70rpx; }
  .metric-ring-value { max-width: 66rpx; font-size: 15rpx; }
  .metric-current { font-size: 21rpx; line-height: 29rpx; }
  .metric-current-compact { font-size: 19rpx; }
  .metric-target { font-size: 20rpx; line-height: 28rpx; }
  .status-stock-line { align-items: flex-start; }
  .summary-top .stock-identity { flex-wrap: nowrap; }
  .status-name { font-size: 30rpx; }
  .quote-line .change { font-size: 30rpx; }
  .metric-card { height: 176rpx; min-height: 176rpx; padding: 14rpx; }
  .metric-copy { padding-left: 2rpx; }
  .metric-ring { width: 112rpx; height: 112rpx; flex-basis: 112rpx; }
  .metric-ring-inner { width: 84rpx; height: 84rpx; }
  .metric-ring-value { font-size: 16rpx; }
  .metric-current { font-size: 27rpx; }
  .metric-remaining { font-size: 17rpx; }
  .alert-row { gap: 8rpx; font-size: 18rpx; }
  .alert-caption { font-size: 17rpx; }
  .matrix-count-2 .matrix-head, .matrix-count-2 .matrix-row { grid-template-columns: 112rpx repeat(2, minmax(0, 1fr)); }
  .matrix-count-5 .matrix-head, .matrix-count-5 .matrix-row { grid-template-columns: 106rpx repeat(5, minmax(0, 1fr)); }
  .matrix-label, .matrix-value, .matrix-input { font-size: 18rpx; }
  .matrix-input-wrap { width: 94%; }
}
