<view class="page stock-page">
  <view class="search-wrap">
    <view class="search-box {{searchFocused ? 'focused' : ''}}">
      <view class="search-icon"></view>
      <input class="search-input" value="{{query}}" placeholder="输入股票名称、代码或首字母" confirm-type="search" bindfocus="onSearchFocus" bindblur="onSearchBlur" bindinput="onQueryInput" />
      <text wx:if="{{query}}" class="clear-icon" hover-class="tap-feedback" hover-stay-time="80" bindtap="clearQuery">×</text>
    </view>
    <view wx:if="{{searchError}}" class="inline-error">{{searchError}}</view>
    <view wx:if="{{suggestions.length || suggestionHint}}" class="suggestions card">
      <view wx:for="{{suggestions}}" wx:key="ts_code" class="suggestion" hover-class="tap-feedback" hover-stay-time="80" bindtap="chooseStock" data-index="{{index}}">
        <view class="suggestion-identity"><text class="suggestion-name">{{item.name}}</text><text class="suggestion-code">{{item.symbol}}</text><text wx:if="{{item.isST}}" class="st-badge">ST</text></view><text class="suggestion-market">{{item.marketLabel}}</text>
      </view>
      <view wx:if="{{suggestionHint}}" class="suggestion-hint">匹配到 {{suggestionTotal}} 条，仅显示前 5 条，请继续输入</view>
    </view>
  </view>
  <view class="history-row">
    <view class="history-title-wrap"><view class="history-clock"><view class="clock-hand clock-hand-hour"></view><view class="clock-hand clock-hand-minute"></view></view><text class="history-label">历史:</text></view>
    <scroll-view class="history-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view class="history-items"><view wx:if="{{!recentStocks.length}}" class="history-empty">暂无历史记录</view><view wx:for="{{recentStocks}}" wx:key="ts_code" class="history-chip" hover-class="tap-feedback" data-index="{{index}}" bindtap="chooseRecent">{{item.name}}</view></view>
    </scroll-view>
    <view class="history-clear" hover-class="history-clear-pressed" aria-label="清空搜索历史" bindtap="clearHistory"><view class="history-trash"><view class="trash-lid"></view><view class="trash-can"><view></view><view></view></view></view><text>清空</text></view>
  </view>
  <block wx:if="{{!detail && !detailError && !detailLoading}}">
    <view class="guide-card card">
      <view class="guide-target" aria-label="异动计算引导图"><view class="guide-ring guide-ring-outer"><view class="guide-ring guide-ring-middle"><view class="guide-ring guide-ring-inner"><view class="guide-pointer"></view></view></view></view></view>
      <view class="guide-line guide-line-primary">搜索你想查询的股票</view>
      <view class="guide-lines">
        <view class="guide-line guide-line-secondary">按交易所最新规则计算</view>
        <view class="guide-line guide-line-item"><text class="guide-bullet">·</text>当前异动状态</view>
        <view class="guide-line guide-line-item"><text class="guide-bullet">·</text>四项预警阈值</view>
        <view class="guide-line guide-line-item"><text class="guide-bullet">·</text>未来十日偏离</view>
      </view>
    </view>
  </block>

  <view wx:if="{{detailLoading}}" class="card loading-state">正在查询最新行情…</view>
  <view wx:if="{{detailError}}" class="card error-state">{{detailError}}</view>

  <block wx:if="{{detail}}">
    <view class="status-banner card status-{{detail.statusClass}}">
      <view class="status-main">
        <view class="summary-top"><view class="stock-identity"><text class="status-name">{{detail.name}}</text><text class="status-symbol">{{detail.symbol}}</text></view><view class="quote-line"><text class="status-price change {{detail.changeClass}}">{{detail.currentPrice}}</text><text class="change {{detail.changeClass}}">{{detail.change}}</text></view></view>
        <view class="status-label-divider"></view>
        <view class="status-stock-line">
          <text class="status-pill status-pill-{{detail.summaryTone}}">{{detail.summaryStatus}}</text>
          <view class="next-day-forecast">
            <text wx:if="{{nextDayForecastLine}}" class="next-day-forecast-date">{{nextDayForecastLine}}</text>
            <text class="next-day-forecast-result">{{nextDayForecastText}}</text>
          </view>
          <view wx:if="{{detail.monitoringSummary}}" class="monitoring-summary">
            <view class="monitoring-divider"></view>
            <text class="monitoring-badge">已被重点监管</text>
            <view class="monitoring-meta"><text>监管日期：{{detail.monitoringSummary.dateText}} · 剩余 </text><text class="monitoring-emphasis">{{detail.monitoringSummary.remainingText}}</text><text> 天</text></view>
            <view class="monitoring-reason"><text>监管原因：</text><text>{{detail.monitoringSummary.ruleText}}</text></view>
          </view>
        </view>
      </view>
    </view>

    <view class="metric-grid">
      <view wx:for="{{detail.warnings}}" wx:key="title" wx:for-index="metricIndex" class="card metric-card metric-card-{{metricIndex}} metric-tone-{{item.tone}}">
        <view class="metric-copy"><text class="metric-title">{{item.title}}</text><text class="metric-current {{item.valueClass || ''}}">{{item.currentText}}</text><text class="metric-target">{{item.target}}</text></view>
        <view class="metric-ring" style="background: conic-gradient({{item.toneColor}} {{item.progress}}%, #DCEBFA 0);"><view class="metric-ring-inner"><text class="metric-ring-value" style="color: {{item.toneColor}};">{{item.ringText}}</text></view></view>
      </view>
    </view>

    <view class="section simulation-section">
      <view class="simulation-head"><view class="simulation-heading"><view class="simulation-title">模拟计算</view><view class="simulation-note">填入股票与指数涨幅后自动重算</view></view><view class="days-picker"><view class="day-option {{simulationExpanded ? 'active' : ''}}" hover-class="button-press" hover-stay-time="100" bindtap="expandSimulation">10日计算</view></view></view>
      <view wx:for="{{matrixGroups}}" wx:for-item="matrix" wx:key="groupKey" class="matrix-card {{matrix.countClass}}">
        <view class="matrix-head"><text class="matrix-label">指标</text><view wx:for="{{matrix.columns}}" wx:for-item="column" wx:key="*this" class="matrix-column"><text class="day-badge">{{column.day}}</text><text class="table-date">{{column.date}}</text></view></view>
      <view wx:for="{{matrix.rows}}" wx:for-item="matrixRow" wx:key="key" class="matrix-row"><text class="matrix-label">{{matrixRow.label}}</text><view wx:for="{{matrixRow.values}}" wx:for-item="cell" wx:key="*this" class="matrix-cell"><block wx:if="{{cell.placeholder}}"><text class="matrix-placeholder">—</text></block><block wx:elif="{{cell.editable}}"><view class="matrix-input-wrap"><input class="matrix-input" type="digit" placeholder="0" value="{{cell.value}}" selection-start="{{cell.selectionStart}}" selection-end="{{cell.selectionEnd}}" data-row="{{cell.rowIndex}}" data-field="{{cell.field}}" bindfocus="selectInput" bindblur="blurInput" bindinput="editRow" /><text wx:if="{{cell.value !== ''}}" class="matrix-suffix">%</text></view></block><block wx:else><text class="matrix-value {{matrixRow.key === 'space' ? 'safety-value' : cell.className}}">{{cell.value}}</text></block></view></view>
      </view>
    </view>
  </block>
  <view class="legal-footer-links">
    <navigator class="page-footer-link" url="/pages/privacy/index" hover-class="tap-feedback" hover-stay-time="80">隐私政策</navigator>
    <text class="footer-separator">·</text>
    <navigator class="page-footer-link" url="/pages/agreement/index" hover-class="tap-feedback" hover-stay-time="80">用户协议</navigator>
    <text class="footer-separator">·</text>
    <navigator class="page-footer-link" url="/pages/rules/index" hover-class="tap-feedback" hover-stay-time="80">规则说明</navigator>
  </view>
</view>
