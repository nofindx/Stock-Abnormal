<view class="page stock-page">
  <view class="home-brand">
    <image class="home-brand-logo" src="/assets/brand-mark.svg" mode="aspectFit" aria-hidden="true"></image>
    <text class="home-brand-name">小源的异动阈值助手</text>
  </view>
  <view class="search-wrap">
    <view class="search-box {{searchFocused ? 'focused' : ''}}">
      <view class="search-icon"></view>
      <input class="search-input" value="{{query}}" placeholder="输入股票名称、代码或首字母" confirm-type="search" bindfocus="onSearchFocus" bindblur="onSearchBlur" bindinput="onQueryInput" />
      <text wx:if="{{query}}" class="clear-icon" hover-class="tap-feedback" hover-stay-time="80" bindtap="clearQuery" aria-role="button" aria-label="清除搜索内容">×</text>
    </view>
    <view wx:if="{{searchError}}" class="inline-error">{{searchError}}</view>
    <view wx:if="{{suggestions.length || suggestionHint}}" class="suggestions card">
      <view wx:for="{{suggestions}}" wx:key="ts_code" class="suggestion" hover-class="tap-feedback" hover-stay-time="80" bindtap="chooseStock" data-index="{{index}}" aria-role="button" aria-label="选择{{item.name}}">
        <view class="suggestion-identity"><text class="suggestion-name">{{item.name}}</text><text class="suggestion-code">{{item.symbol}}</text><text wx:if="{{item.isST}}" class="st-badge">ST</text></view><text class="suggestion-market">{{item.marketLabel}}</text>
      </view>
      <view wx:if="{{suggestionHint}}" class="suggestion-hint">匹配到 {{suggestionTotal}} 条，仅显示前 5 条，请继续输入</view>
    </view>
  </view>
  <view class="history-row">
    <view class="history-title-wrap"><view class="history-clock"><view class="clock-hand clock-hand-hour"></view><view class="clock-hand clock-hand-minute"></view></view><text class="history-label">历史:</text></view>
    <scroll-view class="history-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view class="history-items"><view wx:if="{{!recentStocks.length}}" class="history-empty">暂无搜索记录</view><view wx:for="{{recentStocks}}" wx:key="ts_code" class="history-chip" hover-class="tap-feedback" data-index="{{index}}" bindtap="chooseRecent" aria-role="button" aria-label="打开{{item.name}}"><text class="history-chip-name">{{item.name}}</text><text class="history-chip-arrow" aria-hidden="true">›</text></view></view>
    </scroll-view>
    <view class="history-clear" hover-class="history-clear-pressed" aria-role="button" aria-label="清空搜索历史" bindtap="clearHistory"><image class="history-trash" src="/assets/clear-history.svg" mode="aspectFit" aria-hidden="true"></image></view>
  </view>
  <official-ad placement="home_history_below" allowed="{{true}}"></official-ad>
  <block wx:if="{{!detail && !detailError && !detailLoading}}">
    <view class="guide-card card">
      <view class="guide-target" aria-label="异动计算引导图"><view class="guide-ring guide-ring-outer"><view class="guide-ring guide-ring-middle"><view class="guide-ring guide-ring-inner"><view class="guide-pointer"></view></view></view></view></view>
      <view class="guide-line guide-line-primary">搜索你想查询的股票</view>
      <view class="guide-lines">
        <view class="guide-line guide-line-secondary">按交易所最新规则计算</view>
        <view class="guide-line guide-line-item"><text class="guide-bullet">·</text>当前异动状态</view>
        <view class="guide-line guide-line-item"><text class="guide-bullet">·</text>四项预警阈值</view>
        <view class="guide-line guide-line-item"><text class="guide-bullet">·</text>未来十日偏离</view>
      </view>
    </view>
  </block>

  <view wx:if="{{detailLoading}}" class="card loading-state">正在查询最新行情…</view>
  <view wx:if="{{detailError}}" class="card error-state">{{detailError}}</view>

  <view hidden="{{!detail}}">
    <view class="status-banner card status-{{detail.statusClass}} stock-export-node stock-export-section" data-export-section="status" data-export-kind="box">
      <view class="status-main stock-export-node" data-export-section="status" data-export-kind="box">
        <view class="summary-top stock-export-node" data-export-section="status" data-export-kind="box"><view class="stock-identity stock-export-node" data-export-section="status" data-export-kind="box"><text class="status-name stock-export-node" data-export-section="status" data-export-text="{{detail.name}}" data-export-kind="text">{{detail.name}}</text><text class="status-symbol stock-export-node" data-export-section="status" data-export-text="{{detail.symbol}}" data-export-kind="text">{{detail.symbol}}</text></view><view class="quote-line stock-export-node" data-export-section="status" data-export-kind="box"><text class="status-price change {{detail.changeClass}} stock-export-node" data-export-section="status" data-export-text="{{detail.currentPrice}}" data-export-kind="text">{{detail.currentPrice}}</text><text class="change {{detail.changeClass}} stock-export-node" data-export-section="status" data-export-text="{{detail.change}}" data-export-kind="text">{{detail.change}}</text></view></view>
        <view class="status-label-divider stock-export-node" data-export-section="status" data-export-kind="box"></view>
        <view class="status-stock-line stock-export-node" data-export-section="status" data-export-kind="box">
          <text class="status-pill status-pill-{{detail.summaryTone}} stock-export-node" data-export-section="status" data-export-text="{{detail.summaryStatus}}" data-export-kind="text">{{detail.summaryStatus}}</text>
          <view class="next-day-forecast stock-export-node" data-export-section="status" data-export-kind="box">
            <text wx:if="{{nextDayForecastLine}}" class="next-day-forecast-date stock-export-node" data-export-section="status" data-export-text="{{nextDayForecastLine}}" data-export-kind="text">{{nextDayForecastLine}}</text>
            <text class="next-day-forecast-result stock-export-node" data-export-section="status" data-export-text="{{nextDayForecastText}}" data-export-kind="text">{{nextDayForecastText}}</text>
            <text wx:if="{{nextDayForecastNotice}}" class="next-day-forecast-notice stock-export-node" data-export-section="status" data-export-text="{{nextDayForecastNotice}}" data-export-kind="text">{{nextDayForecastNotice}}</text>
            <view wx:if="{{detail.currentTriggered}}" class="next-day-prediction-extra stock-export-node" data-export-section="status" data-export-kind="box">
              <text class="next-day-forecast-date stock-export-node" data-export-section="status" data-export-text="{{detail.futureForecastLine}}" data-export-kind="text">{{detail.futureForecastLine}}</text>
              <text class="next-day-forecast-result stock-export-node" data-export-section="status" data-export-text="{{detail.futureForecastText}}" data-export-kind="text">{{detail.futureForecastText}}</text>
            </view>
          </view>
          <view wx:if="{{detail.tradingBanner}}" class="trading-status stock-export-node" data-export-section="status" data-export-kind="box">
            <text class="trading-status-label stock-export-node" data-export-section="status" data-export-text="{{detail.tradingBanner.label}}" data-export-kind="text">{{detail.tradingBanner.label}}</text>
            <text wx:if="{{detail.tradingBanner.reason}}" class="stock-export-node" data-export-section="status" data-export-text="{{detail.tradingBanner.reason}}" data-export-kind="text">{{detail.tradingBanner.reason}}</text>
          </view>
          <view wx:for="{{detail.monitoringSummaries}}" wx:for-item="monitorEntry" wx:key="key" class="monitoring-summary stock-export-node" data-export-section="status" data-export-kind="box">
            <view class="monitoring-divider stock-export-node" data-export-section="status" data-export-kind="box"></view>
            <text class="monitoring-badge stock-export-node" data-export-section="status" data-export-text="{{monitorEntry.badgeText}}" data-export-kind="text">{{monitorEntry.badgeText}}</text>
            <view wx:if="{{monitorEntry.pendingStart}}" class="monitoring-meta stock-export-node" data-export-section="status" data-export-text="监管日期：{{monitorEntry.dateText}}" data-export-kind="text">监管日期：{{monitorEntry.dateText}}</view>
            <view wx:else class="monitoring-meta stock-export-node" data-export-section="status" data-export-kind="box"><text class="stock-export-node" data-export-section="status" data-export-text="监管日期：{{monitorEntry.dateText}} · 剩余" data-export-kind="text">监管日期：{{monitorEntry.dateText}} · 剩余 </text><text class="monitoring-emphasis stock-export-node" data-export-section="status" data-export-text="{{monitorEntry.remainingText}}" data-export-kind="text">{{monitorEntry.remainingText}}</text><text class="stock-export-node" data-export-section="status" data-export-text="天" data-export-kind="text"> 天</text></view>
            <view class="monitoring-reason stock-export-node" data-export-section="status" data-export-kind="box"><text class="stock-export-node" data-export-section="status" data-export-text="监管原因：" data-export-kind="text">监管原因：</text><text class="stock-export-node" data-export-section="status" data-export-text="{{monitorEntry.ruleText}}" data-export-kind="text">{{monitorEntry.ruleText}}</text></view>
          </view>
        </view>

      </view>
    </view>

    <view class="metric-grid stock-export-node stock-export-section" data-export-section="warnings" data-export-kind="box">
      <view wx:for="{{detail.warnings}}" wx:key="title" wx:for-index="metricIndex" class="card metric-card metric-card-{{metricIndex}} metric-tone-{{item.tone}} metric-card-{{item.labelTone}} stock-export-node" data-export-section="warnings" data-export-kind="box">
        <view class="metric-copy stock-export-node" data-export-section="warnings" data-export-kind="box"><text class="metric-label metric-label-{{item.labelTone}} stock-export-node" data-export-section="warnings" data-export-text="{{item.title}}" data-export-kind="text">{{item.title}}</text><view class="metric-current {{item.valueClass || ''}} stock-export-node" data-export-section="warnings" data-export-kind="box"><text class="metric-current-number stock-export-node" style="font-size: {{item.currentFontSize}}rpx" data-export-section="warnings" data-export-text="{{item.currentNumber || item.currentText}}" data-export-kind="text">{{item.currentNumber || item.currentText}}</text><text wx:if="{{item.currentUnit}}" class="metric-current-unit stock-export-node" data-export-section="warnings" data-export-text="{{item.currentUnit}}" data-export-kind="text">{{item.currentUnit}}</text></view><text class="metric-target stock-export-node" data-export-section="warnings" data-export-text="{{item.target}}" data-export-kind="text">{{item.target}}</text></view>
        <view class="metric-ring stock-export-node" style="background: conic-gradient({{item.toneColor}} {{item.progress}}%, #E5E7EB 0);" data-export-section="warnings" data-export-progress="{{item.progress}}" data-export-color="{{item.toneColor}}" data-export-kind="ring"><view class="metric-ring-inner stock-export-node" data-export-section="warnings" data-export-kind="box"><text class="metric-ring-value {{item.ringValueClass || ''}} stock-export-node" data-export-section="warnings" data-export-text="{{item.ringText}}" data-export-kind="ring-label">{{item.ringText}}</text></view></view>
      </view>
    </view>

    <official-ad placement="stock_simulation_above" allowed="{{!!detail && !detailLoading && !detailError}}"></official-ad>
    <view class="section simulation-section stock-export-node stock-export-section" data-export-section="simulation" data-export-kind="box">
      <view class="simulation-head stock-export-node" data-export-section="simulation" data-export-kind="box"><view class="simulation-heading stock-export-node" data-export-section="simulation" data-export-kind="box"><view class="simulation-title stock-export-node" data-export-section="simulation" data-export-text="模拟计算" data-export-kind="text">模拟计算</view><view class="simulation-note stock-export-node" data-export-section="simulation" data-export-text="填入股票与指数涨幅后自动重算" data-export-kind="text">填入股票与指数涨幅后自动重算</view></view><view class="days-picker stock-export-node" data-export-section="simulation" data-export-kind="box"><view class="day-option {{simulationExpanded ? 'active' : ''}} stock-export-node" hover-class="button-press" hover-stay-time="100" bindtap="expandSimulation" aria-role="button" aria-label="展开十日模拟计算" data-export-section="simulation" data-export-text="{{simulationUnlocking ? '解锁中…' : '10日计算'}}" data-export-kind="text">{{simulationUnlocking ? '解锁中…' : '10日计算'}}</view><view class="simulation-clear stock-export-node" hover-class="simulation-clear-pressed" hover-stay-time="360" bindtap="clearInputs" aria-role="button" aria-label="清空模拟输入并恢复{{simulationExpanded ? '十日' : '两日'}}默认计算" data-export-section="simulation" data-export-kind="box"><image class="history-trash stock-export-node" src="/assets/clear-history.svg" mode="aspectFit" aria-hidden="true" data-export-section="simulation" data-export-src="/assets/clear-history.svg" data-export-kind="image"></image></view></view></view>
      <view wx:if="{{simulationRewarded && !simulationExpanded}}" class="simulation-note stock-export-node" data-export-section="simulation" data-export-text="完整观看视频，解锁本次页面的10日计算" data-export-kind="text">完整观看视频，解锁本次页面的10日计算</view>
      <view wx:if="{{!simulationReady}}" class="simulation-loading stock-export-node" data-export-section="simulation" data-export-text="{{detailLoading ? '正在计算模拟基线…' : '模拟数据暂不可用'}}" data-export-kind="text">{{detailLoading ? '正在计算模拟基线…' : '模拟数据暂不可用'}}</view>
      <block wx:if="{{simulationReady}}">
      <view wx:for="{{matrixGroups}}" wx:for-item="matrix" wx:key="groupKey" class="matrix-card {{matrix.countClass}} stock-export-node" data-export-section="simulation" data-export-kind="box">
        <view class="matrix-head stock-export-node" data-export-section="simulation" data-export-kind="box"><text class="matrix-label matrix-head-label stock-export-node" data-export-section="simulation" data-export-text="指标" data-export-kind="text">指标</text><view wx:for="{{matrix.columns}}" wx:for-item="column" wx:key="rowIndex" class="matrix-column stock-export-node" data-export-section="simulation" data-export-kind="box"><text class="day-badge stock-export-node" data-export-section="simulation" data-export-text="{{column.day}}" data-export-kind="text">{{column.day}}</text><text class="table-date stock-export-node" data-export-section="simulation" data-export-text="{{column.date}}" data-export-kind="text">{{column.date}}</text></view></view>
      <view wx:for="{{matrix.rows}}" wx:for-item="matrixRow" wx:key="key" class="matrix-row stock-export-node" data-export-section="simulation" data-export-kind="box"><text class="matrix-label {{matrixRow.key === 'space' ? 'matrix-safety-label' : ''}} stock-export-node" data-export-section="simulation" data-export-text="{{matrixRow.label}}" data-export-kind="text">{{matrixRow.label}}</text><view wx:for="{{matrixRow.values}}" wx:for-item="cell" wx:key="rowIndex" class="matrix-cell stock-export-node" data-export-section="simulation" data-export-kind="box"><block wx:if="{{cell.placeholder}}"><text class="matrix-placeholder stock-export-node" data-export-section="simulation" data-export-text="—" data-export-kind="text">—</text></block><block wx:elif="{{cell.editable}}"><view class="matrix-input-wrap stock-export-node" data-export-section="simulation" data-export-kind="box"><input class="matrix-input stock-export-node" type="digit" placeholder="" value="{{cell.value}}" selection-start="{{cell.selectionStart}}" selection-end="{{cell.selectionEnd}}" data-row="{{cell.rowIndex}}" data-field="{{cell.field}}" bindfocus="selectInput" bindblur="blurInput" bindinput="editRow"  data-export-section="simulation" data-export-text="{{cell.value}}" disabled="{{sharingStock}}" data-export-kind="input"/><text class="matrix-suffix stock-export-node" data-export-section="simulation" data-export-text="%" data-export-kind="text">%</text></view></block><block wx:elif="{{matrixRow.key === 'space' && cell.value === '已触发'}}"><text class="matrix-safety-badge stock-export-node" data-export-section="simulation" data-export-text="已触发" data-export-kind="text">已触发</text></block><block wx:else><text class="matrix-value {{matrixRow.key === 'space' ? 'safety-value' : cell.className}} stock-export-node" data-export-section="simulation" data-export-text="{{cell.value}}" data-export-kind="text">{{cell.value}}</text></block></view></view>
      </view>
      </block>
    </view>
    <view class="stock-share-card card">
      <view class="simulation-heading stock-share-heading"><view class="simulation-title">分享一下</view><view class="simulation-note">保存当前股票状态与异动计算结果</view></view>
      <view class="share-actions">
        <button class="share-btn share-btn--primary" open-type="share" hover-class="share-btn--primary-active" disabled="{{sharingStock || detailLoading}}" aria-label="发给微信朋友或群"><image class="share-btn-icon" src="/assets/weui-share/friend.svg" mode="aspectFit" aria-hidden="true"></image><text>发给朋友</text></button>
        <button class="share-btn share-btn--ghost" bindtap="saveStockPage" hover-class="share-btn--ghost-active" disabled="{{sharingStock || detailLoading}}" aria-label="将当前股票结果图片保存到系统相册"><image class="share-btn-icon" src="/assets/weui-share/save.svg" mode="aspectFit" aria-hidden="true"></image><text>{{sharingStock ? '保存中…' : '保存图片'}}</text></button>
      </view>
    </view>
  </view>
  <view class="legal-footer-links">
    <navigator class="page-footer-link" url="/pages/privacy/index" hover-class="tap-feedback" hover-stay-time="80">隐私与用户协议</navigator>
    <text class="footer-separator">·</text>
    <navigator class="page-footer-link" url="/pages/rules/index" hover-class="tap-feedback" hover-stay-time="80">规则说明</navigator>
  </view>
  <canvas type="2d" id="stock-share-canvas" class="stock-share-canvas" aria-hidden="true"></canvas>
  <canvas type="2d" id="stock-share-cover-canvas" class="stock-share-canvas" aria-hidden="true"></canvas>
</view>
