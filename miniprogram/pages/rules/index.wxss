.rules-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 120rpx;
  background: #F2F2F7;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
}
.rules-updated { margin: 16rpx 0 6rpx; color: #636366; font-size: 21rpx; line-height: 30rpx; text-align: left; }
.rules-updated + .rules-section { margin-top: 6rpx; }
.rules-section { margin-top: 22rpx; padding: 20rpx; border: 1rpx solid #E5E5EA; border-radius: 18rpx; background: #FFFFFF; }
.rules-heading { margin-bottom: 14rpx; color: #1C1C1E; font-size: 25rpx; font-weight: 600; line-height: 34rpx; }
.formula { color: #636366; font-size: 22rpx; line-height: 36rpx; text-indent: 0; }
.rules-copy { margin-top: 12rpx; color: #636366; font-size: 21rpx; line-height: 34rpx; text-indent: 0; }
.threshold-table { box-sizing: border-box; width: calc(100% + 40rpx); margin: 0 -20rpx -20rpx; overflow: hidden; border: 1rpx solid #E5E5EA; border-radius: 0 0 18rpx 18rpx; background: #F8F8FA; }
.threshold-row { display: grid; grid-template-columns: 1fr .6fr 1.45fr 1.45fr .6fr; align-items: center; min-height: 68rpx; padding: 0 12rpx; border-bottom: 1rpx solid #E5E5EA; color: #636366; font-size: 21rpx; line-height: 30rpx; text-align: center; }
.threshold-row:last-child { border-bottom: 0; }
.threshold-row > text { min-width: 0; white-space: nowrap; text-align: center; }
.threshold-row > view { min-width: 0; }
.threshold-pair { min-width: 0; white-space: nowrap; font-size: 21rpx; text-align: center; }
.threshold-name { color: #1C1C1E; font-size: 21rpx; font-weight: 600; text-align: center; }
.threshold-header { min-height: 62rpx; background: #EEF0F3; color: #636366; font-size: 21rpx; font-weight: 600; }
.rules-muted { color: #636366; }
.rules-risk { border-color: #E5E5EA; background: #FFFFFF; }
.rules-page .free-note { display: none; }

@media (max-width: 390px) {
  .rules-page { padding-right: 22rpx; padding-left: 22rpx; }
  .threshold-row { grid-template-columns: 1fr .6fr 1.45fr 1.45fr .6fr; padding-right: 8rpx; padding-left: 8rpx; font-size: 21rpx; }
  .threshold-name,
  .threshold-header,
  .threshold-pair { font-size: 21rpx; }
}
