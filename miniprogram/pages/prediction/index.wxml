<!-- 预测页三层卡片结构：行情、偏离与触发条件、规则 -->
<view class="page prediction-page">
  <view class="segmented card"><view class="segment {{scope === 'today' ? 'active' : ''}}" hover-class="tap-feedback" data-scope="today" bindtap="switchScope">当日预测</view><view class="segment {{scope === 'next_day' ? 'active' : ''}} {{!nextDayAvailable ? 'segment-disabled' : ''}}" hover-class="tap-feedback" data-scope="next_day" bindtap="switchScope">次日预测</view></view>
  <view class="snapshot-row prediction-snapshot-row"><view class="snapshot-summary"><text>共 <text class="snapshot-count">{{items.length}}</text> 条</text><text wx:if="{{updatedAt || refreshing}}" class="snapshot-dot">·</text><text wx:if="{{updatedAt}}">数据更新于 {{updatedAt}}</text><text wx:elif="{{refreshing}}" class="snapshot-pending">正在获取数据</text></view><button class="snapshot-refresh {{buttonRefreshing ? 'snapshot-refresh-disabled' : ''}}" loading="{{buttonRefreshing}}" disabled="{{buttonRefreshing}}" hover-class="button-press" bindtap="refresh">刷新</button></view>
  <view wx:if="{{dataMessage}}" class="prediction-phase-note">{{dataMessage}}</view>
  <view wx:if="{{loading}}" class="card loading-state">正在加载预测快照…</view>
  <view wx:if="{{error}}" class="card error-state">{{error}}</view>
  <view class="prediction-list"><view wx:for="{{items}}" wx:key="ts_code" class="prediction-row" hover-class="tap-feedback" bindtap="openStock" data-code="{{item.ts_code}}"><view class="prediction-top"><view class="prediction-stock"><view class="stock-line"><text class="stock-name">{{item.name}}</text><text class="stock-meta">{{item.symbol}}</text></view></view><view class="prediction-quote"><text class="prediction-price">{{item.currentPrice || '--'}}</text><text class="prediction-change change {{item.changeClass}}">{{item.change}}</text></view></view><view class="prediction-middle"><view class="deviation-field"><text class="prediction-label">偏离值</text><text class="deviation">{{item.deviation}}</text></view><view class="trigger-field"><text class="prediction-label">触发条件</text><text class="trigger-value">{{item.trigger}}</text></view></view><view class="prediction-rule"><text class="prediction-label">异动规则</text><text class="rule-value">{{item.rule}}</text></view></view></view>
  <view wx:if="{{refreshing && !items.length}}" class="card loading-state">正在更新预测快照…</view>
  <view wx:if="{{!items.length && !refreshing}}" class="card empty">当前范围暂无候选股票</view>
  <view class="page-footer-links"><text class="page-footer-link" hover-class="tap-feedback" bindtap="openPrivacy">隐私政策</text><text class="footer-separator">·</text><text class="page-footer-link" hover-class="tap-feedback" bindtap="openAgreement">用户协议</text><text class="footer-separator">·</text><text class="page-footer-link" hover-class="tap-feedback" bindtap="openRules">规则说明</text></view>
</view>
