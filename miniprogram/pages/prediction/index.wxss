.prediction-page .page-header { display: none; }
.prediction-page .segmented { margin-top: 16rpx; }
.prediction-snapshot-row { position: relative; display: flex; align-items: center; min-height: 48rpx; margin-top: 14rpx; padding-right: 120rpx; box-sizing: border-box; }
.prediction-snapshot-row .snapshot-summary { display: flex; min-width: 0; max-width: 100%; align-items: baseline; gap: 10rpx; color: #6B7280; font-size: 22rpx; line-height: 30rpx; white-space: nowrap; overflow: hidden; }
.prediction-snapshot-row .snapshot-count { color: #1A1A1A; font-size: 28rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.prediction-snapshot-row .snapshot-dot { color: #9CA3AF; }
.prediction-snapshot-row .snapshot-pending { color: #9CA3AF; }
.prediction-snapshot-row .snapshot-refresh { position: absolute; top: 50%; right: 0; display: flex; width: 120rpx; min-width: 120rpx; max-width: 120rpx; height: 48rpx; align-items: center; justify-content: center; margin: 0; padding: 0 !important; border: 1rpx solid #DDE3EA; border-radius: 11rpx; background: #FFFFFF; color: #405A78; font-size: 20rpx; font-weight: 600; line-height: 1; transform: translateY(-50%); }
.prediction-snapshot-row .snapshot-refresh::after { display: none; }
.prediction-snapshot-row .snapshot-refresh-disabled { opacity: .56; }
.prediction-snapshot-row .snapshot-quality { display: block; margin-top: 3rpx; color: #8A6D0B; font-size: 20rpx; line-height: 1.4; }
.refresh-panel { display: none; }
.refresh-copy { min-width: 0; }
.refresh-label { display: block; color: #1C1C1E; font-size: 23rpx; font-weight: 600; }
.refresh-panel .refresh-time { display: block; margin-top: 3rpx; color: #8E8E93; font-size: 20rpx; font-variant-numeric: tabular-nums; }
.prediction-page .segmented {
  display: flex;
  padding: 5rpx;
  margin-top: 14rpx;
  border: 0;
  border-radius: 15rpx;
  background: #E5E5EA;
}
.prediction-page .segment {
  flex: 1;
  padding: 13rpx 0;
  border-radius: 11rpx;
  color: #636366;
  font-size: 23rpx;
  line-height: 32rpx;
  text-align: center;
}
.prediction-page .segment.active { background: #FFFFFF; color: #1C1C1E; font-weight: 600; box-shadow: 0 1rpx 4rpx rgba(28, 28, 30, .10); }
.prediction-page .segment-disabled { color: #A7A7AD; background: transparent; opacity: .62; }
.notice { display: none; }
.summary, .list-head, .title-row { display: none; }
.prediction-list { overflow: visible; margin-top: 16rpx; border: 0; background: transparent; }
.prediction-page .loading-state, .prediction-page .error-state { margin-top: 14rpx; padding: 34rpx 24rpx; color: #8E8E93; text-align: center; }
.prediction-page .error-state { color: #C83A36; }
.prediction-row {
  margin-top: 12rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid #E5E5EA;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(28, 28, 30, .035);
}
.prediction-row:first-child { margin-top: 0; }
.prediction-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.prediction-stock { display: flex; min-width: 0; flex: 1; align-items: baseline; gap: 10rpx; }
.prediction-page .stock-line { display: flex; align-items: baseline; gap: 14rpx; }
.quote-label { color: #8E8E93; font-size: 18rpx; }
.scope-mark { flex: 0 0 auto; padding: 4rpx 9rpx; border-radius: 7rpx; background: #F2F2F7; color: #636366; font-size: 19rpx; }
.prediction-page .stock-name { color: #1A1A1A; font-size: 28rpx; font-weight: 600; white-space: nowrap; }
.prediction-page .stock-meta { margin-left: 14rpx; color: #6B7280; font-size: 22rpx; font-variant-numeric: tabular-nums; white-space: nowrap; }
.prediction-quote { display: flex; flex: 0 0 auto; align-items: baseline; gap: 10rpx; white-space: nowrap; }
.quote-copy { display: flex; flex-direction: column; align-items: flex-end; gap: 2rpx; }
.prediction-change { font-size: 29rpx; letter-spacing: .1rpx; }
.prediction-price { color: #1A1A1A; font-size: 32rpx; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
.badge-today { background: #F2F2F7; color: #636366; }
.prediction-middle {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(230rpx, 1.1fr);
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F2F2F7;
}
.trigger-field, .deviation-field { min-width: 0; }
.deviation-field { padding-left: 14rpx; border-left: 1rpx solid #E5E5EA; }
.trigger-block {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F2F2F7;
}
.trigger-value { min-width: 0; color: #1C1C1E; font-size: 24rpx; font-weight: 600; line-height: 33rpx; overflow-wrap: break-word; }
.trigger-field .trigger-value { color: #C0271E; font-size: 23rpx; font-weight: 700; white-space: nowrap; letter-spacing: 0; }
.prediction-bottom { display: none; }
.prediction-bottom > view { min-width: 0; }
.rule-field { padding-left: 14rpx; border-left: 1rpx solid #E5E5EA; }
.prediction-label { display: block; margin-bottom: 4rpx; color: #8E8E93; font-size: 19rpx; line-height: 26rpx; }
.prediction-value { display: block; color: #1C1C1E; font-size: 22rpx; line-height: 30rpx; overflow-wrap: break-word; }
.deviation { color: #1A1A1A; font-size: 26rpx; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
.rule-value { display: block; color: #636366; font-size: 20rpx; line-height: 29rpx; }
.prediction-rule { margin-top: 14rpx; padding-top: 13rpx; border-top: 1rpx solid #E5E5EA; }
.prediction-rule .prediction-label { margin-bottom: 5rpx; }
.prediction-rule .rule-value { color: #636366; font-size: 22rpx; line-height: 31rpx; }
.refresh-bar { display: none; }
.refresh-button {
  min-height: 48rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid #007AFF;
  border-radius: 24rpx;
  background: #0A84FF;
  color: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(10, 132, 255, .16);
  font-size: 20rpx;
  line-height: 48rpx;
}
.refresh-button.loading { border-color: #E5E5EA; background: #F2F2F7; color: #8E8E93; }
.refresh-panel .refresh-button { margin-left: auto; }
.refresh-icon { display: inline-block; margin-right: 5rpx; font-size: 24rpx; line-height: 1; vertical-align: -2rpx; }
.refresh-feedback { background: #F2F2F7 !important; }
.spinning { animation: spin .8s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

@media (max-width: 390px) {
  .prediction-page .prediction-row { padding: 18rpx 16rpx; }
  .prediction-quote { gap: 7rpx; }
  .prediction-price, .prediction-change { font-size: 25rpx; }
  .prediction-page .badge { padding: 0 8rpx; font-size: 18rpx; }
  .rule-value { font-size: 19rpx; }
  .prediction-middle { grid-template-columns: minmax(0, .82fr) minmax(204rpx, 1.18fr); gap: 9rpx; }
  .trigger-field .trigger-value { font-size: 20rpx; }
  .refresh-button { padding: 0 14rpx; font-size: 21rpx; }
}
