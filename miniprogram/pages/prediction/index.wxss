.prediction-page { padding-top: 24rpx; padding-bottom: 220rpx; }
.next-day-notice { position: fixed; z-index: 100; top: 50%; left: 50%; display: flex; width: 400rpx; max-width: calc(100vw - 80rpx); box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; padding: 24rpx 28rpx; border-radius: 14rpx; background: #59595B; color: #FFFFFF; font-size: 28rpx; line-height: 46rpx; text-align: center; transform: translate(-50%, -50%); }
.prediction-page .page-header { display: none; }
.prediction-page .segmented { height: 60rpx; align-items: center; margin-top: 12rpx; }
.prediction-snapshot-row { position: relative; display: flex; width: 100%; height: 48rpx; min-height: 48rpx; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 22rpx; padding-right: 0; box-sizing: border-box; }
.prediction-snapshot-row .snapshot-summary { display: flex; min-width: 0; width: auto; max-width: none; flex: 1; align-items: baseline; gap: 10rpx; color: #6B7280; font-size: 22rpx; line-height: 30rpx; white-space: nowrap; overflow: hidden; }
.prediction-snapshot-row .snapshot-count { color: #1A1A1A; font-size: 28rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.prediction-snapshot-row .snapshot-dot { color: #636366; }
.prediction-snapshot-row .snapshot-pending { color: #636366; }
.prediction-page .snapshot-refresh { display: flex; width: 48rpx; height: 48rpx; flex: 0 0 48rpx; align-items: center; justify-content: center; margin-left: auto; border: 1rpx solid #B9D6F2; border-radius: 9rpx; background: #EAF3FC; color: #185A96; box-sizing: border-box; }
.prediction-page .snapshot-refresh-pressed { border-color: #8DBBE8; background: #D8EAF9; }
.prediction-page .snapshot-refresh-icon { display: block; width: 28rpx; height: 28rpx; opacity: .85; }
.prediction-page .snapshot-refreshing .snapshot-refresh-icon { animation: snapshot-refresh-spin 0.8s linear infinite; }
@keyframes snapshot-refresh-spin { to { transform: rotate(315deg); } }
.refresh-panel { display: none; }
.refresh-copy { min-width: 0; }
.refresh-label { display: block; color: #1C1C1E; font-size: 23rpx; font-weight: 600; }
.refresh-panel .refresh-time { display: block; margin-top: 3rpx; color: #636366; font-size: 20rpx; font-variant-numeric: tabular-nums; }
.prediction-page .segmented {
  display: flex;
  height: 60rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx;
  border: 1rpx solid #E8EAED;
  border-radius: 12rpx;
  background: #E8EAED;
}
.prediction-controls { display: flex; width: 100%; height: 80rpx; min-height: 80rpx; box-sizing: border-box; align-items: center; justify-content: flex-start; gap: 14rpx; margin-top: 12rpx; }
.prediction-page .prediction-controls .segmented { width: 100%; flex: 0 0 100%; margin-top: 0; }
.prediction-page .segment {
  flex: 1;
  height: 50rpx;
  padding: 0;
  border: 0;
  border-radius: 9rpx;
  background: transparent;
  color: #4B5158;
  font-size: 23rpx;
  line-height: 50rpx;
  text-align: center;
  box-sizing: border-box;
}
.prediction-page .segment.active { background: #FFFFFF; color: #1C1C1E; font-weight: 600; box-shadow: 0 1rpx 4rpx rgba(28, 28, 30, .12); }
.prediction-page .segment-disabled { color: #4B5158; opacity: 1; }
.notice { display: none; }
.summary, .list-head, .title-row { display: none; }
.prediction-list { overflow: visible; margin-top: 24rpx; border: 0; background: transparent; }
.prediction-page .loading-state, .prediction-page .error-state { margin-top: 14rpx; padding: 34rpx 24rpx; color: #636366; text-align: center; }
.prediction-page .error-state { color: #C83A36; }
.prediction-row {
  margin-top: 12rpx;
  padding: 18rpx;
  border: 1rpx solid #EBEDF0;
  border-radius: 14rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 26, .025);
}
.prediction-row-triggered { border-color: #E9A6A1; background: #FFF1F0; }
.prediction-alert { display: none; }
.prediction-row:first-child { margin-top: 0; }
.prediction-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.prediction-stock { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: flex-start; gap: 4rpx; overflow: hidden; }
.prediction-page .stock-line { display: flex; min-width: 0; align-items: baseline; gap: 12rpx; overflow: hidden; }
.quote-label { color: #636366; font-size: 18rpx; }
.scope-mark { flex: 0 0 auto; padding: 4rpx 9rpx; border-radius: 7rpx; background: #F2F2F7; color: #636366; font-size: 19rpx; }
.prediction-page .stock-name { min-width: 0; overflow: hidden; color: #1A1A1A; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.prediction-page .stock-meta { flex: 0 0 auto; margin-left: 0; color: #6B7280; font-size: 20rpx; font-variant-numeric: tabular-nums; white-space: nowrap; }
.prediction-quote, .trigger-field { display: flex; flex: 0 0 192rpx; width: 192rpx; align-items: center; white-space: nowrap; }
.prediction-metric-control { position: relative; left: -10rpx; flex-basis: 202rpx; width: 202rpx; }
.prediction-quote .prediction-change-prefix, .trigger-field .prediction-label { flex: 0 0 90rpx; width: 90rpx; margin-right: 12rpx; color: #6B7280; font-size: 20rpx; line-height: 28rpx; text-align: right; white-space: nowrap; }
.prediction-change-value, .trigger-value { flex: 0 0 100rpx; width: 100rpx; color: #D93025; font-size: 24rpx; font-weight: 700; line-height: 30rpx; text-align: left; font-variant-numeric: tabular-nums; }
.prediction-change-value.change.up { color: #D93025; }
.prediction-change-value.change.down { color: #0E9F6E; }
.badge-today { background: #F2F2F7; color: #636366; }
.prediction-middle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 44rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F2F2F7;
}
.deviation-field { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: flex-start; gap: 12rpx; overflow: hidden; white-space: nowrap; }
.prediction-tag { flex: 0 0 auto; padding: 0 10rpx; border-radius: 8rpx; font-size: 20rpx; line-height: 30rpx; white-space: nowrap; }
.prediction-tag { background: #F2F2F7; color: #636366; }
.prediction-rule-tag, .prediction-deviation-tag, .prediction-triggered-badge { padding: 2rpx 10rpx; border: 2rpx solid #FF8A8A; border-radius: 8rpx; background: #FFF5F5; color: #C0271E; line-height: 30rpx; box-sizing: border-box; }
.prediction-rule-tag { font-weight: 600; }
.prediction-deviation-tag { font-variant-numeric: tabular-nums; }
.prediction-triggered-badge { font-weight: 600; }
.trigger-field { justify-content: flex-start; }
.trigger-field .prediction-label { font-weight: 400; }
.trigger-value { color: #D93025; }
.prediction-bottom { display: none; }
.rule-field { padding-left: 14rpx; border-left: 1rpx solid #E5E5EA; }
.prediction-value { display: block; color: #1C1C1E; font-size: 22rpx; line-height: 30rpx; overflow-wrap: break-word; }
.rule-value { display: block; color: #636366; font-size: 20rpx; line-height: 29rpx; }
.refresh-bar { display: none; }
.refresh-button {
  min-height: 48rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid #007AFF;
  border-radius: 24rpx;
  background: #0A84FF;
  color: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(10, 132, 255, .16);
  font-size: 20rpx;
  line-height: 48rpx;
}
.refresh-button.loading { border-color: #E5E5EA; background: #F2F2F7; color: #636366; }
.refresh-panel .refresh-button { margin-left: auto; }
.refresh-icon { display: inline-block; margin-right: 5rpx; font-size: 24rpx; line-height: 1; vertical-align: -2rpx; }
.refresh-feedback { background: #F2F2F7 !important; }
.spinning { animation: spin .8s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* Card backgrounds describe today's confirmed trigger state, not rule severity. */
.prediction-page .segment.active { border-color: transparent !important; color: #1C1C1E !important; }
.prediction-page .trigger-value { color: #D93025 !important; }
.prediction-page .prediction-deviation-tag,
.prediction-page .prediction-rule-tag,
.prediction-page .prediction-triggered-badge { border-color: #636366 !important; background: #F2F3F5 !important; color: #1C1C1E !important; }
.prediction-page .prediction-row { border-color: #EBEDF0 !important; background: #FFFFFF !important; }
.prediction-page .prediction-row-today.prediction-row-triggered { border-color: #D93025 !important; background: #FFF5F5 !important; }
.prediction-page .prediction-row-next_day,
.prediction-page .prediction-row-next_day.prediction-row-triggered { border-color: #EBEDF0 !important; background: #FFFFFF !important; }
.prediction-page .refresh-button { border-color: #636366 !important; background: #FFFFFF !important; color: #1C1C1E !important; box-shadow: none !important; }
.prediction-page .refresh-button.loading { border-color: #D1D5DB !important; background: #F2F3F5 !important; color: #6B7280 !important; }
.prediction-page .error-state { color: #4B5563 !important; }
.prediction-page .snapshot-updated { margin-left: 0; text-align: left; }
.prediction-page .prediction-deviation-tag,
.prediction-page .prediction-rule-tag,
.prediction-page .prediction-triggered-badge { border-color: #D93025 !important; background: #FFF5F5 !important; color: #D93025 !important; }

.prediction-page .prediction-tone-ordinary { border-color: #E2BC3E !important; background: #FFF5CC !important; color: #755900 !important; }
.prediction-page .prediction-tone-severe { border-color: #D93025 !important; background: #FFF5F5 !important; color: #C0271E !important; }
.prediction-page .prediction-value-ordinary { color: #8A6D0B !important; }
.prediction-page .prediction-value-severe { color: #D93025 !important; }


@media (max-width: 390px) {
  .prediction-page .badge { padding: 0 8rpx; font-size: 18rpx; }
  .rule-value { font-size: 19rpx; }
  .refresh-button { padding: 0 14rpx; font-size: 21rpx; }
}
