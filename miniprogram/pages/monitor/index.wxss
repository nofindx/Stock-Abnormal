.monitor-page { background: #F2F3F5; padding-top: 24rpx; padding-bottom: 220rpx; }
.filter-row { display: flex; width: 100%; height: 80rpx; min-height: 80rpx; box-sizing: border-box; align-items: center; justify-content: flex-start; margin-top: 12rpx; }
.type-filters {
  display: flex;
  flex: 1 1 auto;
  width: auto;
  min-width: 0;
  height: 72rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx;
  border: 1rpx solid #DDE3EA;
  border-radius: 12rpx;
  background: #F2F3F5;
}
.filter-segment {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  height: 62rpx;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 9rpx;
  background: transparent;
  color: #6B7280;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 62rpx;
  text-align: center;
  white-space: nowrap;
}
.filter-segment-risk, .filter-segment-severe, .filter-segment-delisting {
  flex-basis: 0;
  width: auto;
  min-width: 0;
  padding: 0;
}
.filter-segment-all { font-size: 21rpx; }
.filter-segment.active,
.filter-segment-risk.active,
.filter-segment-severe.active,
.filter-segment-delisting.active { background: #FFFFFF; color: #1C1C1E; font-weight: 600; box-shadow: 0 1rpx 4rpx rgba(28, 28, 30, .12); }
.snapshot-row { position: relative; display: flex; height: 48rpx; min-height: 48rpx; align-items: center; margin-top: 12rpx; box-sizing: border-box; }
.snapshot-summary { display: flex; min-width: 0; max-width: 100%; align-items: baseline; gap: 10rpx; color: #6B7280; font-size: 22rpx; line-height: 30rpx; white-space: nowrap; overflow: hidden; }
.snapshot-count { color: #1A1A1A; font-size: 28rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.snapshot-dot { color: #9CA3AF; }
.snapshot-pending { color: #9CA3AF; }
.monitor-list { margin-top: 24rpx; }
.monitor-row { position: relative; margin-top: 12rpx; padding: 18rpx; border: 1rpx solid #EBEDF0; border-radius: 14rpx; background: #FFFFFF; box-shadow: 0 2rpx 8rpx rgba(26, 26, 26, .025); }
.monitor-tone-ordinary, .monitor-tone-severe-10d, .monitor-tone-severe-30d { background: #FFFFFF; }
.monitor-row:first-child { margin-top: 0; }
.monitor-row-top, .monitor-row-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.monitor-stock { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8rpx; }
.stock-line { display: flex; min-width: 0; align-items: baseline; gap: 12rpx; overflow: hidden; }
.monitor-period { color: #6B7280; font-size: 20rpx; font-variant-numeric: tabular-nums; }
.monitor-row-bottom { min-height: 44rpx; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #F2F2F7; }
.monitor-risk { display: inline-flex; min-width: 0; align-items: center; gap: 16rpx; }
.source-link { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 4rpx; color: #2F80ED; font-size: 20rpx; font-weight: 600; line-height: 30rpx; }
.source-link-icon { font-size: 20rpx; line-height: 30rpx; }
.monitor-page .stock-name { min-width: 0; flex: 0 1 auto; overflow: hidden; color: #1A1A1A; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.monitor-page .stock-meta { flex: 0 0 auto; margin: 0; color: #6B7280; font-size: 20rpx; font-variant-numeric: tabular-nums; white-space: nowrap; }
.monitor-page .badge { max-width: 220rpx; min-height: 30rpx; padding: 0 10rpx; border-radius: 8rpx; font-size: 20rpx; line-height: 30rpx; }
.monitor-page .badge-ordinary { background: #FFFCF8; color: #8A6D0B; }
.monitor-page .badge-severe-10d { background: #FFF7F2; color: #E0501F; }
.monitor-page .badge-severe-30d { background: #FDF3F2; color: #C0271E; }
.monitor-page .badge-delisting-warning { background: #FFF7F2; color: #C0271E; }
.row-grid { display: none; }
.grid-label { display: block; color: #8E8E93; font-size: 19rpx; line-height: 26rpx; }
.grid-value { display: block; margin-top: 4rpx; color: #1C1C1E; font-size: 22rpx; font-weight: 500; line-height: 30rpx; font-variant-numeric: tabular-nums; }
.days-value { display: inline-flex; width: 184rpx; align-items: center; justify-content: flex-end; color: #1A1A1A; font-size: 20rpx; font-weight: 600; line-height: 30rpx; text-align: right; white-space: nowrap; }
.days-label { flex: 0 0 auto; }
.days-number { width: 48rpx; margin: 0 8rpx; color: #C0271E; font-size: 34rpx; font-weight: 750; line-height: 34rpx; text-align: center; font-variant-numeric: tabular-nums; }
.days-value.days-ordinary { color: #8A6D0B; }
.days-value.days-severe-10d { color: #E0501F; }
.days-value.days-severe-30d { color: #C0271E; }
.days-label { color: #1A1A1A; font-size: 20rpx; }
.days-unit { color: #1A1A1A; font-size: 20rpx; font-weight: 400; }
.monitor-page .empty { margin-top: 16rpx; background: #FFFFFF; }
.monitor-page .loading-state, .monitor-page .error-state { margin-top: 16rpx; padding: 34rpx 24rpx; color: #6B7280; text-align: center; }
.monitor-page .error-state { border-color: #E4B4AD; background: #FDF3F2; color: #C0271E; }
.monitor-skeleton { opacity: .95; }
.skeleton-row { min-height: 156rpx; background: #FAFBFC; }
.skeleton-line { border-radius: 6rpx; background: #E9EDF1; }
.skeleton-name { width: 180rpx; height: 29rpx; }
.skeleton-code { width: 100rpx; height: 20rpx; margin-top: 10rpx; }
.skeleton-divider { height: 1rpx; margin: 18rpx 0 14rpx; background: #EBEDF0; }
.skeleton-badge { width: 150rpx; height: 30rpx; }
.skeleton-days { width: 200rpx; height: 25rpx; margin-left: auto; margin-top: -25rpx; }
.chip-feedback { opacity: .72; }

/* Monitoring status is informational, not a price quote: keep it grayscale. */
.monitor-page .filter-segment.active,
.monitor-page .filter-segment-risk.active,
.monitor-page .filter-segment-severe.active,
.monitor-page .filter-segment-delisting.active { border-color: transparent !important; background: #FFFFFF !important; color: #1C1C1E !important; font-weight: 600 !important; box-shadow: 0 1rpx 4rpx rgba(28, 28, 30, .12); }
.monitor-page .source-link,
.monitor-page .badge-ordinary,
.monitor-page .badge-severe-10d,
.monitor-page .badge-severe-30d,
.monitor-page .days-value,
.monitor-page .days-value.days-ordinary,
.monitor-page .days-value.days-severe-10d,
.monitor-page .days-value.days-severe-30d,
.monitor-page .days-number { color: #1C1C1E !important; }
.monitor-page .badge-ordinary,
.monitor-page .badge-severe-10d,
.monitor-page .badge-severe-30d { background: #F2F3F5 !important; }
.monitor-page .badge-delisting-warning { background: #F2F3F5 !important; }
.monitor-page .error-state { border-color: #D1D5DB !important; background: #F2F3F5 !important; color: #4B5563 !important; }

.monitor-page .snapshot-summary { width: 100%; }
.monitor-page .snapshot-updated { margin-left: 0; text-align: left; }
.monitor-page .source-link { color: #2F80ED !important; }
.monitor-page .badge-ordinary,
.monitor-page .badge-severe-10d,
.monitor-page .badge-severe-30d { padding: 2rpx 10rpx !important; border: 2rpx solid #D93025 !important; border-radius: 8rpx; background: #FFF5F5 !important; color: #D93025 !important; line-height: 30rpx; }
.monitor-page .badge-delisting-warning { padding: 2rpx 10rpx !important; border: 2rpx solid #D93025 !important; border-radius: 8rpx; background: #FFF5F5 !important; color: #D93025 !important; line-height: 30rpx; }
.monitor-page .days-number { color: #D93025 !important; }
