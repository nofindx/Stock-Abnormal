.monitor-page { background: #F2F3F5; }
.monitor-page .segmented {
  display: flex;
  padding: 5rpx;
  margin-top: 14rpx;
  border: 0;
  border-radius: 15rpx;
  background: #E5E5EA;
}
.monitor-page .segment {
  flex: 1;
  padding: 13rpx 0;
  border-radius: 11rpx;
  color: #636366;
  font-size: 23rpx;
  line-height: 32rpx;
  text-align: center;
}
.monitor-page .segment.active { background: #FFFFFF; color: #1C1C1E; font-weight: 600; box-shadow: 0 1rpx 4rpx rgba(28, 28, 30, .10); }
.filter-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 16rpx; }
.type-filters { display: flex; flex: 0 0 50%; width: 50%; min-width: 0; align-items: center; justify-content: space-between; gap: 0; }
.filter-segment {
  flex: 0 0 88rpx;
  width: 88rpx;
  min-width: 88rpx;
  height: 48rpx;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid #DDE3EA;
  border-radius: 11rpx;
  background: #FFFFFF;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 46rpx;
  text-align: center;
  white-space: nowrap;
}
.filter-segment-risk, .filter-segment-severe {
  flex-basis: auto;
  width: auto;
  min-width: 112rpx;
  padding: 0 20rpx;
}
.filter-segment-all { font-size: 20rpx; }
.filter-segment.active { border-color: #0E8796; background: #0E8796; color: #FFFFFF; box-shadow: 0 2rpx 6rpx rgba(14, 135, 150, .16); }
.filter-segment-risk.active { border-color: #D5B84A; background: #FFF7E0; color: #8A6D0B; box-shadow: none; }
.filter-segment-severe.active { border-color: #E49A8E; background: #FDEBE8; color: #C0271E; box-shadow: none; }
.st-control {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
}
.st-label { color: #6B7280; font-size: 22rpx; font-weight: 600; white-space: nowrap; }
.st-native-switch-wrap { display: flex; width: 78rpx; height: 48rpx; align-items: center; justify-content: flex-end; overflow: visible; }
.st-native-switch { flex: 0 0 auto; transform: scale(.75); transform-origin: right center; }
.snapshot-row { position: relative; display: flex; align-items: center; margin-top: 14rpx; min-height: 48rpx; padding-right: 120rpx; box-sizing: border-box; }
.snapshot-summary { display: flex; min-width: 0; max-width: 100%; align-items: baseline; gap: 10rpx; color: #6B7280; font-size: 22rpx; line-height: 30rpx; white-space: nowrap; overflow: hidden; }
.snapshot-count { color: #1A1A1A; font-size: 28rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.snapshot-dot { color: #9CA3AF; }
.snapshot-pending { color: #9CA3AF; }
.snapshot-refresh { position: absolute; top: 50%; right: 0; display: flex; width: 120rpx; min-width: 120rpx; max-width: 120rpx; height: 48rpx; align-items: center; justify-content: center; margin: 0; padding: 0 !important; border: 1rpx solid #DDE3EA; border-radius: 11rpx; background: #FFFFFF; color: #405A78; font-size: 20rpx; font-weight: 600; line-height: 1; transform: translateY(-50%); }
.snapshot-refresh::after { display: none; }
.snapshot-refresh[disabled] { opacity: .56; }
.days-number { display: inline-block; margin: 0 3rpx; font-size: 34rpx; font-weight: 700; line-height: 38rpx; }
.history-label { color: #9CA3AF; font-size: 22rpx; }
.snapshot-meta { display: none; }
.snapshot-state { color: #9CA3AF; }
.list-meta { display: none; }
.monitor-list { margin-top: 16rpx; }
.monitor-row { position: relative; margin-top: 12rpx; padding: 18rpx; border: 1rpx solid #EBEDF0; border-radius: 14rpx; background: #FFFFFF; box-shadow: 0 2rpx 8rpx rgba(26, 26, 26, .025); }
.monitor-tone-ordinary { background: #FFFCF8; }
.monitor-tone-severe-10d { background: #FFFDFC; }
.monitor-tone-severe-30d { background: #FDF3F2; }
.monitor-row:first-child { margin-top: 0; }
.monitor-row-top, .monitor-row-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.monitor-stock { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8rpx; }
.stock-line { display: flex; align-items: baseline; gap: 14rpx; }
.monitor-period { color: #6B7280; font-size: 22rpx; font-variant-numeric: tabular-nums; }
.monitor-row-bottom { margin-top: 16rpx; padding-top: 13rpx; border-top: 1rpx solid #F2F2F7; }
.source-link { flex: 0 0 auto; color: #2F80ED; font-size: 22rpx; font-weight: 600; }
.monitor-page .stock-name { flex: 0 1 auto; color: #1A1A1A; font-size: 28rpx; font-weight: 600; white-space: nowrap; }
.monitor-page .stock-meta { flex: 0 0 auto; margin: 0 0 0 14rpx; color: #6B7280; font-size: 22rpx; }
.muted-security .stock-name, .muted-security .stock-meta, .muted-security .monitor-period, .muted-security .days-value { color: #9CA3AF; }
.muted-security .stock-name { font-weight: 500; }
.monitor-page .badge { max-width: 220rpx; }
.monitor-page .badge-ordinary { background: #FFFCF8; color: #8A6D0B; }
.monitor-page .badge-severe-10d { background: #FFF7F2; color: #E0501F; }
.monitor-page .badge-severe-30d { background: #FDF3F2; color: #C0271E; }
.row-grid { display: none; }
.grid-label { display: block; color: #8E8E93; font-size: 19rpx; line-height: 26rpx; }
.grid-value { display: block; margin-top: 4rpx; color: #1C1C1E; font-size: 22rpx; font-weight: 500; line-height: 30rpx; font-variant-numeric: tabular-nums; }
.days-value { color: #1A1A1A; font-size: 20rpx; font-weight: 500; }
.days-value.days-ordinary { color: #8A6D0B; }
.days-value.days-severe-10d { color: #E0501F; }
.days-value.days-severe-30d { color: #C0271E; }
.days-unit { color: #8E8E93; font-size: 19rpx; font-weight: 400; }
.monitor-page .empty { margin-top: 16rpx; background: #FFFFFF; }
.monitor-page .loading-state, .monitor-page .error-state { margin-top: 16rpx; padding: 34rpx 24rpx; color: #6B7280; text-align: center; }
.monitor-page .error-state { border-color: #E4B4AD; background: #FDF3F2; color: #C0271E; }
.monitor-skeleton { opacity: .95; }
.skeleton-row { min-height: 156rpx; background: #FAFBFC; }
.skeleton-line { border-radius: 6rpx; background: #E9EDF1; }
.skeleton-name { width: 180rpx; height: 29rpx; }
.skeleton-code { width: 100rpx; height: 20rpx; margin-top: 10rpx; }
.skeleton-divider { height: 1rpx; margin: 18rpx 0 14rpx; background: #EBEDF0; }
.skeleton-badge { width: 150rpx; height: 30rpx; }
.skeleton-days { width: 200rpx; height: 25rpx; margin-left: auto; margin-top: -25rpx; }
.chip-feedback { opacity: .72; }
