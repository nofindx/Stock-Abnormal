<view class="page monitor-page">
  <view class="filter-row">
    <view class="type-filters">
      <view wx:for="{{types}}" wx:key="key" class="filter-segment filter-segment-{{item.key}} {{type === item.key ? 'active' : ''}}" hover-class="chip-feedback" data-type="{{item.key}}" bindtap="selectType">{{item.label}}</view>
    </view>
    <view class="st-control">
      <text class="st-label">去杂</text>
      <view class="st-native-switch-wrap"><switch class="st-native-switch" checked="{{hideNoise}}" color="#0E8796" bindchange="toggleNoise" /></view>
    </view>
  </view>
  <view class="snapshot-row">
    <view class="snapshot-summary">
      <text>共 <text class="snapshot-count">{{visibleCount}}</text> 条</text>
      <text wx:if="{{updatedAt || refreshing}}" class="snapshot-dot">·</text>
      <text wx:if="{{updatedAt}}">数据更新于 {{updatedAt}}</text>
      <text wx:elif="{{refreshing}}" class="snapshot-pending">正在获取数据</text>
    </view>
    <button class="snapshot-refresh {{buttonRefreshing ? 'snapshot-refresh-disabled' : ''}}" loading="{{buttonRefreshing}}" disabled="{{buttonRefreshing}}" hover-class="button-feedback" bindtap="refreshSnapshot">刷新</button>
  </view>
  <view wx:if="{{error}}" class="card error-state">{{error}}</view>
  <view wx:if="{{items.length}}" class="monitor-list"><view wx:for="{{items}}" wx:key="monitorKey" class="monitor-row monitor-tone-{{item.riskTone}} {{item.mutedSecurity ? 'muted-security' : ''}}"><view class="monitor-row-top"><view class="monitor-stock"><view class="stock-line"><text class="stock-name">{{item.name}}</text><text class="stock-meta">{{item.symbol}}</text></view></view><text class="monitor-period">{{item.monitorStart}} 至 {{item.monitorEnd}}</text></view><view class="monitor-row-bottom"><view class="monitor-risk"><text class="badge badge-{{item.riskTone}}">{{item.monitorType}}</text><view wx:if="{{item.sourceUrl && item.riskTone !== 'ordinary'}}" class="source-link" hover-class="tap-feedback" data-url="{{item.sourceUrl}}" bindtap="openSource"><text class="source-link-icon">↗</text><text>公告</text></view></view><text class="days-value days-{{item.riskTone}}"><text class="days-label">剩余</text><text class="days-number">{{item.days}}</text><text class="days-unit">天</text></text></view></view></view>
  <view wx:elif="{{loading}}" class="monitor-list monitor-skeleton" aria-label="正在加载监控池"><view wx:for="{{skeletonRows}}" wx:key="*this" class="monitor-row skeleton-row"><view class="skeleton-line skeleton-name"></view><view class="skeleton-line skeleton-code"></view><view class="skeleton-divider"></view><view class="skeleton-line skeleton-badge"></view><view class="skeleton-line skeleton-days"></view></view></view>
  <view wx:elif="{{refreshing}}" class="card loading-state">正在更新监控快照…</view>
  <view wx:else class="card empty">当前筛选条件下暂无记录</view>
</view>
