<view class="page monitor-page">
  <view class="segmented card"><view class="segment {{tab === 'current' ? 'active' : ''}}" hover-class="tap-feedback" data-tab="current" bindtap="selectTab">当前监控</view><view class="segment {{tab === 'history' ? 'active' : ''}}" hover-class="tap-feedback" data-tab="history" bindtap="selectTab">历史监控</view></view>
  <view class="filter-row"><view wx:for="{{types}}" wx:key="key" class="filter-chip filter-{{item.key}} {{type === item.key ? 'active' : ''}}" hover-class="chip-feedback" data-type="{{item.key}}" bindtap="selectType">{{item.label}}</view><view class="st-switch"><text class="st-switch-label">去除 ST</text><switch checked="{{hideST}}" color="#4F6B8A" bindchange="toggleST" /></view></view>
  <view wx:if="{{updatedAt || waitingSeconds}}" class="snapshot-meta"><text wx:if="{{updatedAt}}">数据更新于 {{updatedAt}}</text><text wx:if="{{waitingSeconds}}">正在获取今日快照 · 已等待 {{waitingSeconds}} 秒</text><text wx:if="{{refreshing && updatedAt}}" class="snapshot-state">更新中</text></view>
  <view wx:if="{{error}}" class="card error-state">{{error}}</view>
  <view wx:if="{{items.length}}" class="monitor-list"><view wx:for="{{items}}" wx:key="monitorKey" class="monitor-row monitor-tone-{{item.riskTone}}"><view class="monitor-row-top"><view class="monitor-stock"><view class="stock-line"><text class="stock-name">{{item.name}}</text><text class="stock-meta">{{item.symbol}}</text></view></view><text class="monitor-period">{{item.monitorStart}} 至 {{item.monitorEnd}}</text></view><view class="monitor-row-bottom"><text class="badge badge-{{item.riskTone}}">{{item.monitorType}}</text><text wx:if="{{!item.isHistory}}" class="days-value days-{{item.riskTone}}">剩余 <text class="days-number">{{item.days}}</text> 个交易日</text><text wx:else class="history-label">历史监控</text></view></view></view>
  <view wx:elif="{{loading}}" class="monitor-list monitor-skeleton" aria-label="正在加载监控池"><view wx:for="{{skeletonRows}}" wx:key="*this" class="monitor-row skeleton-row"><view class="skeleton-line skeleton-name"></view><view class="skeleton-line skeleton-code"></view><view class="skeleton-divider"></view><view class="skeleton-line skeleton-badge"></view><view class="skeleton-line skeleton-days"></view></view></view>
  <view wx:elif="{{refreshing}}" class="card loading-state">正在更新监控快照…</view>
  <view wx:else class="card empty">当前筛选条件下暂无记录</view>
</view>
