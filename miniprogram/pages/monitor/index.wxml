<view class="page monitor-page">
  <view class="page-header"><text class="page-title">监控池</text></view>
  <view class="segmented card"><view class="segment {{tab === 'current' ? 'active' : ''}}" hover-class="tap-feedback" data-tab="current" bindtap="selectTab">当前监控</view><view class="segment {{tab === 'history' ? 'active' : ''}}" hover-class="tap-feedback" data-tab="history" bindtap="selectTab">历史监控</view></view>
  <view class="filter-row"><view wx:for="{{types}}" wx:key="key" class="filter-chip filter-{{item.key}} {{type === item.key ? 'active' : ''}}" hover-class="chip-feedback" data-type="{{item.key}}" bindtap="selectType">{{item.label}}</view><view class="st-switch"><text class="st-switch-label">去除 ST</text><switch checked="{{hideST}}" color="#1C1C1E" bindchange="toggleST" /></view></view>
  <view wx:if="{{loading}}" class="card loading-state">正在加载监控记录…</view>
  <view wx:if="{{error}}" class="card error-state">{{error}}</view>
  <view wx:if="{{items.length}}" class="monitor-list"><view wx:for="{{items}}" wx:key="monitorKey" class="monitor-row"><view class="monitor-row-top"><view class="monitor-stock"><view class="stock-line"><text class="stock-name">{{item.name}}</text><text class="stock-meta">{{item.symbol}}</text></view></view><text class="monitor-period">{{item.monitorStart}} 至 {{item.monitorEnd}}</text></view><view class="monitor-row-bottom"><text class="badge badge-{{item.riskLevel}}">{{item.monitorType}}</text><text wx:if="{{!item.isHistory}}" class="days-value days-{{item.riskLevel}}">剩余 <text class="days-number">{{item.days}}</text> 个交易日</text><text wx:else class="history-label">历史监控</text></view></view></view>
  <view wx:elif="{{refreshing && !items.length}}" class="card loading-state">正在更新监控快照…</view>
  <view wx:else class="card empty">当前筛选条件下暂无记录</view>
  <view class="disclaimer-card"><text class="disclaimer-title">免责声明：</text><text class="disclaimer-body">本工具基于交易所最新规则，使用公开网络数据源进行辅助计算，结果仅供参考，不构成投资建议或买卖依据。请以交易所公告和上市公司公告为准。</text></view>
</view>
