.legal-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 120rpx;
  background: #F2F2F7;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
}
.legal-updated { margin: 0 0 16rpx; color: #636366; font-size: 21rpx; line-height: 30rpx; text-align: left; }
.legal-section { margin-top: 22rpx; padding: 20rpx; border: 1rpx solid #E5E5EA; border-radius: 18rpx; background: #FFFFFF; }
.legal-heading { margin-bottom: 14rpx; color: #1C1C1E; font-size: 25rpx; font-weight: 600; line-height: 34rpx; }
.legal-copy { margin-top: 12rpx; color: #636366; font-size: 21rpx; line-height: 34rpx; }
