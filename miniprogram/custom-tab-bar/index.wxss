.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #F2F3F5;
  background: #FFFFFF;
}

.tab-item {
  display: flex;
  width: 33.3333%;
  height: 108rpx;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 18rpx;
  color: #A2A9B8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.tab-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.tab-label {
  display: block;
  margin-top: 8rpx;
  color: inherit;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 32rpx;
  white-space: nowrap;
}

.tab-item-active { color: #202124; }
.tab-item-active .tab-label { font-weight: 600; }
.tab-item-pressed { background: #F7F8FA; }
